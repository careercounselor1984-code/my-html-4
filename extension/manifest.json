{
  "manifest_version": 3,
  "name": "국취 전산 상담 도우미",
  "version": "1.4.29",
  "version_name": "1.4.29 IAP 자동연동 검증용",
  "description": "전산 업무자동화 · 민감정보 보관기간 관리와 메시지 보안 강화 · Work24 IAP·구직준비도 입력",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.work24.go.kr/*",
    "https://careercounselor1984-code.github.io/*",
    "file:///*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "국취 전산 상담 도우미",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.work24.go.kr/*"
      ],
      "js": [
        "basic_content.js",
        "allowance_content.js",
        "termination_content.js",
        "counsel-save-core.js",
        "counsel-save-content.js",
        "client-context-work24.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://careercounselor1984-code.github.io/my-html-4/*",
        "file:///*"
      ],
      "js": [
        "bridge-security.js",
        "training-core.js",
        "counsel_bridge_content.js",
        "direct_bridge_v148.js",
        "training-journal.js",
        "readiness-journal.js",
        "client-context-journal.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.work24.go.kr/hr/a/a/3100/selectTracseDetl.do*",
        "https://m.work24.go.kr/hr/a/a/3100/selectTracseDetl.do*"
      ],
      "js": [
        "training/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
